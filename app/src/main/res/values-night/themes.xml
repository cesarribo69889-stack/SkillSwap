<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.SkillSwap" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary_light</item>
        <item name="colorOnPrimary">#1B1033</item>
        <item name="colorPrimaryContainer">#37276B</item>
        <item name="colorOnPrimaryContainer">#E9E3FF</item>

        <item name="colorSecondary">@color/brand_secondary</item>
